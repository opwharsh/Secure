# Discord bot token from Discord Developer Portal
DISCORD_TOKEN=put_your_bot_token_here

# ID of the one channel where language moderation and manual deletion should run
TARGET_CHANNEL_ID=put_channel_id_here

# Server ID for instant guild slash command registration (recommended)
GUILD_ID=put_server_id_here

# Status rotation interval in seconds (minimum 15)
STATUS_INTERVAL_SECONDS=30
